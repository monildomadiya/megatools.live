{
  "name": "megatools",
  "version": "1.0.0",
  "private": true,
  "description": "MegaTools — free online calculators and converters",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:content": "tsx scripts/check-content.mts",
    "check:urls": "tsx scripts/check-legacy-urls.mts",
