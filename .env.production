# Loaded by `next build` and `next start` in production only — `next dev` never
# reads this file, so local development stays out of the reporting.
#
# This is committed on purpose. `NEXT_PUBLIC_*` values are inlined into the
# bundle at build time, and the production build runs on the droplet inside the
# deploy job. A value that lives only on the box is not in version control:
# rebuilding the droplet would silently drop analytics with nothing failing to
# say so. A GA4 measurement ID is public regardless — it appears verbatim in the
# gtag URL on every page. Real secrets go in repository secrets, never here.

NEXT_PUBLIC_GA_ID=G-LL4CZRXQJ7
