# Copy to .env.local to override any of these locally. `.env.local` is ignored
# by git and wins over every other env file.
#
# Production values that are not secret live in `.env.production`, which is
# committed: NEXT_PUBLIC_* is inlined at build time and the production build
# runs on the droplet, so anything set only on the box is outside version
# control and is lost the moment the droplet is rebuilt.

# GA4 measurement ID. Analytics renders nothing when this is unset, which keeps
# `next dev` out of the reporting — `.env.production` is not read in dev mode.
# The production value is in `.env.production`.
NEXT_PUBLIC_GA_ID=

# Leave false until AdSense approval lands. While false, no ad markup of any
# kind is emitted — not a placeholder, not a hidden container.
NEXT_PUBLIC_ADS_ENABLED=false

# ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
